syntax on
set number
filetype indent on
set tabstop=2
set shiftwidth=2
set expandtab
set autoindent
set hlsearch
set incsearch
set ignorecase
set smartcase
set path+=**
set bg=dark
hi Comment ctermfg=blue
hi Search ctermbg=red
hi! link IncSearch Search
nnoremap <space><space> :noh<CR>
nnoremap <space>1 :set nu!<CR>
